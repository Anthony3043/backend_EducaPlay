generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          String   @id @default(uuid())
  nome        String
  email       String   @unique
  senha       String
  papel       String
  instituicao String?
  cargo       String?
  foto        String?
  materias    String[]
  resetToken     String?
  resetTokenExp  DateTime?
  expoPushToken  String?
  ativo              Boolean  @default(true)
  podeEditarMapaSala Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  disponibilidades  Disponibilidade[]
  notificacoes      Notificacao[]
  aulas             Aula[]             @relation("AulaProfessor")
  bloqueios         BloqueioHorario[]  @relation("BloqueiosProfessor")
  pontosRegistrados BaterPonto[]       @relation("PontoProfessor")
}

model Professor {
  id        String   @id @default(uuid())
  nome      String
  materias  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disponibilidades Disponibilidade[]
}

model Sala {
  id         String   @id @default(uuid())
  nome       String
  turma      String?
  capacidade String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  aulas Aula[]
  mapa  MapaSala?
}

model Cronograma {
  id        String   @id @default(uuid())
  turno     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aulas Aula[]
}

model Aula {
  id           String     @id @default(uuid())
  timeStart    String
  timeEnd      String
  subject      String
  diaSemana    String?
  isInterval   Boolean    @default(false)
  cronogramaId String
  professorId  String?
  salaId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cronograma Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  professor  Usuario?   @relation("AulaProfessor", fields: [professorId], references: [id])
  sala       Sala?      @relation(fields: [salaId], references: [id])
  pontos     BaterPonto[]
}

model Disponibilidade {
  id          String    @id @default(uuid())
  diaSemana   String
  turno       String
  professorId String
  usuarioId   String?
  createdAt   DateTime  @default(now())

  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
}

model BloqueioHorario {
  id          String   @id @default(uuid())
  professorId String
  diaSemana   String?
  timeStart   String
  timeEnd     String
  descricao   String?
  createdAt   DateTime @default(now())

  professor Usuario @relation("BloqueiosProfessor", fields: [professorId], references: [id], onDelete: Cascade)
}

model Notificacao {
  id        String   @id @default(uuid())
  titulo    String
  mensagem  String
  icon      String   @default("🔔")
  lida      Boolean  @default(false)
  usuarioId String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MapaSala {
  id        String   @id @default(uuid())
  salaId    String   @unique
  assentos  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sala Sala @relation(fields: [salaId], references: [id], onDelete: Cascade)
}

model BaterPonto {
  id          String   @id @default(uuid())
  professorId String
  aulaId      String
  diaSemana   String
  latitude    Float
  longitude   Float
  timestamp   DateTime @default(now())

  professor Usuario @relation("PontoProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  aula      Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)
}

model ConfiguracaoEscola {
  id        String   @id @default(uuid())
  latitude  Float    @default(0)
  longitude Float    @default(0)
  raio      Float    @default(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
