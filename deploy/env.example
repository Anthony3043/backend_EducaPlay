# Banco de dados (PostgreSQL na VM)
DATABASE_URL="postgresql://educaplay:SENHA_DO_BANCO@localhost:5432/educaplay_db"

# JWT
JWT_SECRET="GERE_UMA_CHAVE_ALEATORIA_LONGA"
JWT_EXPIRES_IN="7d"

# Código de acesso para registro de supervisão
CODIGO_SUPERVISAO="SEU_CODIGO_AQUI"

# Oracle Cloud Object Storage
OCI_REGION="sa-saopaulo-1"
OCI_NAMESPACE="SEU_NAMESPACE_AQUI"
OCI_BUCKET="educaplay-arquivos"
OCI_ACCESS_KEY="CHAVE_DE_ACESSO_CUSTOMER_SECRET"
OCI_SECRET_KEY="CHAVE_SECRETA_CUSTOMER_SECRET"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@seudominio.com"

# Expo Push Notifications
EXPO_ACCESS_TOKEN="SEU_TOKEN_EXPO"
